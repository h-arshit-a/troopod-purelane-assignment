{% comment %}
  Purelane Header Section
  1:1 Visual floating glass pill navbar matching purelane-homepage.html prototype
{% endcomment %}

<header id="hdr" class="header-purelane-wrapper">
  <div class="navpill glass">
    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name | escape }} home">
      <span class="mark">
        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="color:#b8701c" viewBox="0 0 24 24">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"></path>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"></path>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ shop.name | default: 'Purelane' | escape }}</span>
        <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' | escape }}</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav" aria-label="Main navigation">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="{% if link.active %}on{% endif %}">
            {{ link.title | escape }}
          </a>
        {%- endfor -%}
      {%- else -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- endif -%}
    </nav>

    <!-- Nav Tools (Search, Account, Cart, Mobile Burger) -->
    <div class="navtools">
      <!-- Search Button -->
      <a href="{{ routes.search_url }}" class="ico hide-s" aria-label="Search">
        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>

      <!-- Account Button -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="ico hide-s" aria-label="Account">
          <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="3.6"></circle>
            <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"></path>
          </svg>
        </a>
      {%- endif -%}

      <!-- Cart Button -->
      <a href="{{ routes.cart_url }}" class="ico" id="cart-icon-bubble" aria-label="Cart, {{ cart.item_count }} items">
        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24">
          <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"></path>
          <circle cx="10" cy="20.5" r="1.1"></circle>
          <circle cx="17.5" cy="20.5" r="1.1"></circle>
        </svg>
        <span class="dot" data-cart-count>{{ cart.item_count }}</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button type="button" class="ico burger" id="purelane-mobile-menu-trigger" aria-label="Menu">
        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Purelane Header",
  "tag": "section",
  "class": "purelane-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    }
  ],
  "presets": [
    {
      "name": "Purelane Header"
    }
  ]
}
{% endschema %}
