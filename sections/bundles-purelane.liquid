{% comment %}
  Purelane Bundles Section (#bundles)
  1:1 Visual and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec" data-scene="3" id="bundles">
  <div class="wrap">
    <!-- Header Box -->
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">
          {{ section.settings.eyebrow | default: 'Build your bundle' | escape }}
        </span>
        <h2 class="d2" style="margin-top:12px">
          {{ section.settings.heading | default: 'One box. Every room.' | escape }}
        </h2>
        <p class="lede" style="margin:0 auto">
          {{ section.settings.subtitle | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' | escape }}
        </p>
      </div>
    </div>

    <!-- Tiers Grid -->
    <div class="tiers">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_best = block.settings.is_popular
            assign delay_class = ''
            if forloop.index == 2
              assign delay_class = 'rv-d2'
            elsif forloop.index == 3
              assign delay_class = 'rv-d3'
            endif
          -%}

          <article
            class="glass tier {% if is_best %}best{% endif %} rv {{ delay_class }}"
            {{ block.shopify_attributes }}
          >
            <span class="tag">{{ block.settings.tag | default: 'Bundle' | escape }}</span>

            <div class="tierpix {% if block.settings.product_count == '5' or forloop.index == 3 %}five{% endif %}" aria-hidden="true">
              {%- if block.settings.image_1 != blank -%}
                <img
                  src="{{ block.settings.image_1 | image_url: width: 300 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="120"
                  height="120"
                  class="pimg"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <span class="pimg p-combo2" role="img" aria-label="Purelane tap cleaner and kitchen cleaner combo pack"></span>
                  {%- when 2 -%}
                    <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
                    <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
                    <span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span>
                  {%- else -%}
                    <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
                    <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
                    <span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span>
                    <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span>
                    <span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span>
                {%- endcase -%}
              {%- endif -%}
            </div>

            <div class="qty">
              {{ block.settings.product_count }}
              <small>{{ block.settings.qty_label | default: 'Products' | escape }}</small>
            </div>

            <div class="price">
              {{ block.settings.price }}
              {%- if block.settings.original_price != blank -%}
                <s>{{ block.settings.original_price }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.per_product_text != blank -%}
              <p class="body-s" style="font-size:12px">
                {{ block.settings.per_product_text | escape }}
              </p>
            {%- endif -%}

            {%- assign bullets = block.settings.bullets | newline_to_br | split: '<br />' -%}
            {%- if bullets.size > 0 -%}
              <ul>
                {%- for bullet in bullets -%}
                  {%- assign clean_b = bullet | strip_newlines | strip -%}
                  {%- if clean_b != blank -%}
                    <li>
                      <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" viewBox="0 0 24 24">
                        <path d="m5 13 4 4L19 7"></path>
                      </svg>
                      {{ clean_b }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <a
              href="{{ block.settings.btn_link | default: '#shop' }}"
              class="btn {% if is_best %}btn-primary{% else %}btn-ghost{% endif %}"
            >
              {{ block.settings.btn_label | default: 'Build this box' | escape }}
              {%- if is_best -%}
                <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24">
                  <path d="M5 12h13m-5-6 6 6-6 6"></path>
                </svg>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "bundle_tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as Most Popular (Primary Styling)",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tier Tag Title",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product Quantity",
          "default": "2"
        },
        {
          "type": "text",
          "id": "qty_label",
          "label": "Quantity Unit Label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "original_price",
          "label": "Original Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Per Product Calculation Text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Bullet Features (One per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Custom Tier Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "bundle_tier",
          "settings": {
            "is_popular": false,
            "tag": "Starter",
            "product_count": "2",
            "price": "₹349",
            "original_price": "₹598",
            "per_product_text": "Flat ₹174 per product",
            "bullets": "Pick any two products\nFree shipping across India"
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "is_popular": true,
            "tag": "Most popular",
            "product_count": "3",
            "price": "₹499",
            "original_price": "₹897",
            "per_product_text": "Flat ₹166 per product",
            "bullets": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India"
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "is_popular": false,
            "tag": "Whole home",
            "product_count": "5",
            "price": "₹799",
            "original_price": "₹1495",
            "per_product_text": "Flat ₹160 per product",
            "bullets": "Pick any five products\nEvery room in one order\nFree shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
