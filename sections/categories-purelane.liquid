{% comment %}
  Purelane Categories Section (#categories)
  1:1 Visual and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec" data-scene="4" id="categories">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">
        {{ section.settings.eyebrow | default: 'Bundle categories' | escape }}
      </span>
      <h2 class="d2" style="margin-top:12px">
        {{ section.settings.heading | default: 'Find the right bundle for you' | escape }}
      </h2>
    </div>

    <div class="cats">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign delay_idx = forloop.index0 | modulo: 4
            assign delay_class = ''
            if delay_idx == 1
              assign delay_class = 'rv-d1'
            elsif delay_idx == 2
              assign delay_class = 'rv-d2'
            elsif delay_idx == 3
              assign delay_class = 'rv-d3'
            endif
          -%}
          <a class="glass cat rv {{ delay_class }}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
            <span class="ph">
              <span class="pimg {{ block.settings.img_class | default: 'p-kitchen' }}" role="img" aria-label="{{ block.settings.title | escape }}"></span>
            </span>
            <span class="txt">
              <h4>{{ block.settings.title | escape }}</h4>
              <p>{{ block.settings.subtitle | escape }}</p>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Prototype Default 4 Category Cards -->
        <a class="glass cat rv" href="#combos">
          <span class="ph">
            <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
          </span>
          <span class="txt">
            <h4>Kitchen bundle</h4>
            <p>Grease, dishes &amp; more</p>
          </span>
        </a>

        <a class="glass cat rv rv-d1" href="#combos">
          <span class="ph">
            <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span>
          </span>
          <span class="txt">
            <h4>Bathroom bundle</h4>
            <p>Deep clean &amp; disinfect</p>
          </span>
        </a>

        <a class="glass cat rv rv-d2" href="#combos">
          <span class="ph">
            <span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span>
          </span>
          <span class="txt">
            <h4>Laundry bundle</h4>
            <p>Softer, fresher wash</p>
          </span>
        </a>

        <a class="glass cat rv rv-d3" href="#combos">
          <span class="ph">
            <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
          </span>
          <span class="txt">
            <h4>Hard water bundle</h4>
            <p>Melt away limescale</p>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "class": "purelane-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "text",
          "id": "img_class",
          "label": "Icon CSS Class",
          "default": "p-kitchen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Kitchen bundle",
            "subtitle": "Grease, dishes & more",
            "img_class": "p-kitchen"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Bathroom bundle",
            "subtitle": "Deep clean & disinfect",
            "img_class": "p-toilet"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Laundry bundle",
            "subtitle": "Softer, fresher wash",
            "img_class": "p-laundry"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Hard water bundle",
            "subtitle": "Melt away limescale",
            "img_class": "p-tap"
          }
        }
      ]
    }
  ]
}
{% endschema %}
