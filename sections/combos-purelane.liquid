{% comment %}
  Purelane Best-Selling Combos Section (#combos)
  1:1 Visual and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec" data-scene="3" id="combos">
  <div class="wrap">
    <!-- Header Box -->
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">
          {{ section.settings.eyebrow | default: 'Pre-built to save you money' | escape }}
        </span>
        <h2 class="d2" style="margin-top:12px">
          {{ section.settings.heading | default: 'Best selling combos' | escape }}
        </h2>
        <p class="lede" style="margin:0 auto">
          {{ section.settings.subtitle | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' | escape }}
        </p>
      </div>
    </div>

    <!-- Horizontal Combo Rail -->
    <div class="comborail rv">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_hero = block.settings.is_hero
            assign featured_prod = block.settings.product
            if featured_prod == blank and collections.all.products.size > 0
              assign fallback_idx = forloop.index0 | default: 0 | modulo: collections.all.products.size
              assign featured_prod = collections.all.products[fallback_idx]
            endif
            assign active_variant_id = featured_prod.selected_or_first_available_variant.id | default: featured_prod.variants.first.id

            assign combo_price = block.settings.price
            assign combo_compare = block.settings.compare_price
            
            if featured_prod != blank
              assign combo_price = featured_prod.price | money
              if featured_prod.compare_at_price > featured_prod.price
                assign combo_compare = featured_prod.compare_at_price | money
              endif
            endif
          -%}


          <article
            class="glass combo {% if is_hero %}hero-combo{% endif %}"
            {{ block.shopify_attributes }}
          >
            <!-- Card Top Tray -->
            <div class="tray">
              {%- if block.settings.savings_text != blank -%}
                <span class="save">{{ block.settings.savings_text | escape }}</span>
              {%- endif -%}

              {%- if block.settings.flag_text != blank -%}
                <span class="flag">{{ block.settings.flag_text | escape }}</span>
              {%- endif -%}

              <div class="stack">
                <!-- Stack Item 1 -->
                {%- if block.settings.item_1_text != blank -%}
                  <span class="it">
                    {%- if block.settings.item_1_image != blank -%}
                      <img
                        src="{{ block.settings.item_1_image | image_url: width: 120 }}"
                        alt="{{ block.settings.item_1_text | escape }}"
                        loading="lazy"
                        width="34"
                        height="34"
                        class="pimg"
                      >
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_1_class | default: 'p-kitchen' }}" role="img" aria-label="{{ block.settings.item_1_text | escape }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_1_text | escape }}</span>
                  </span>
                {%- endif -%}

                <!-- Stack Item 2 -->
                {%- if block.settings.item_2_text != blank -%}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {%- if block.settings.item_2_is_tile -%}
                      <span class="tile">
                        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24">
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"></path>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"></path>
                        </svg>
                      </span>
                    {%- elsif block.settings.item_2_image != blank -%}
                      <img
                        src="{{ block.settings.item_2_image | image_url: width: 120 }}"
                        alt="{{ block.settings.item_2_text | escape }}"
                        loading="lazy"
                        width="34"
                        height="34"
                        class="pimg"
                      >
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_2_class | default: 'p-dish' }}" role="img" aria-label="{{ block.settings.item_2_text | escape }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_2_text | escape }}</span>
                  </span>
                {%- endif -%}

                <!-- Stack Item 3 -->
                {%- if block.settings.item_3_text != blank -%}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {%- if block.settings.item_3_image != blank -%}
                      <img
                        src="{{ block.settings.item_3_image | image_url: width: 120 }}"
                        alt="{{ block.settings.item_3_text | escape }}"
                        loading="lazy"
                        width="34"
                        height="34"
                        class="pimg"
                      >
                    {%- else -%}
                      <span class="pimg {{ block.settings.item_3_class | default: 'p-tap' }}" role="img" aria-label="{{ block.settings.item_3_text | escape }}"></span>
                    {%- endif -%}
                    <span>{{ block.settings.item_3_text | escape }}</span>
                  </span>
                {%- endif -%}
              </div>
            </div>

            <!-- Card Body -->
            <div class="body">
              <h3>{{ block.settings.title | default: 'Combo Title' | escape }}</h3>

              <div class="cnt">{{ block.settings.product_count_text | default: '3 products' | escape }}</div>

              <p class="inc">
                {{ block.settings.includes_text | escape }}
              </p>

              <div class="prow">
                <strong>{{ combo_price }}</strong>
                {%- if combo_compare != blank -%}
                  <s>{{ combo_compare }}</s>
                {%- endif -%}
                {%- if block.settings.save_tag_text != blank -%}
                  <em>{{ block.settings.save_tag_text | escape }}</em>
                {%- endif -%}
              </div>

              <div class="fine">
                {{ section.settings.fine_print | default: 'Inclusive of all taxes · COD available' | escape }}
              </div>

              <button
                type="button"
                class="btn {% if is_hero %}btn-primary{% else %}btn-ghost{% endif %} purelane-add-to-cart-btn"
                data-variant-id="{{ active_variant_id }}"
                aria-label="Add {{ block.settings.title | escape }} to cart"
              >

                {{ block.settings.btn_label | default: 'Shop bundle' | escape }}
                <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24">
                  <path d="M5 12h13m-5-6 6 6-6 6"></path>
                </svg>
              </button>
            </div>
          </article>

        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Swipe Cue -->
    <div class="swipecue" aria-hidden="true">
      <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24">
        <path d="M5 12h13m-5-6 6 6-6 6"></path>
      </svg>
      {{ section.settings.swipe_cue | default: 'Swipe for more combos' | escape }}
    </div>

    <!-- Rail Note -->
    <p class="railnote">
      {{ section.settings.rail_note | default: 'Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.' | escape }}
    </p>
  </div>
</section>

