{% comment %}
  Purelane Newsletter Club Section
  1:1 Visual and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">
        {{ section.settings.eyebrow | default: 'Join the Purelane Club' | escape }}
      </span>

      <h2 class="d2" style="margin-top:12px">
        {{ section.settings.heading | default: 'Get ₹100 off your first bundle' | escape }}
      </h2>

      <p class="lede" style="margin:0 auto">
        {{ section.settings.subtitle | default: 'Plus first access to new launches and restocks.' | escape }}
      </p>

      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form-fields" style="display:flex;gap:10px;justify-content:center;max-width:440px;margin:20px auto 0">
          <input
            id="NewsletterForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="Newsletter-error--{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="Newsletter-success--{{ section.id }}"
            {% endif %}
            placeholder="{{ section.settings.placeholder | default: 'your@email.com' | escape }}"
            required
            aria-label="Email address"
            style="flex:1;padding:12px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.06);color:#fff"
          >
          <button type="submit" class="btn btn-primary" name="commit" id="Subscribe">
            {{ section.settings.button_label | default: 'Get my ₹100 off' | escape }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="newsletter-form__message newsletter-form__message--success" id="Newsletter-success--{{ section.id }}" tabindex="-1" style="color:#68d986;margin-top:10px;font-size:0.9rem">
            Thanks for subscribing! Check your email for your ₹100 discount code.
          </p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Club Signup",
  "tag": "section",
  "class": "purelane-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle Text",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Input Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Purelane Club Signup"
    }
  ]
}
{% endschema %}
