{% comment %}
  Purelane Proof / Product Rotator Section (#proof)
  1:1 Visual, interactive rotator, and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec" data-scene="3" id="proof">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <!-- Left Column -->
        <div class="proof-l">
          <span class="kicker">
            {{ section.settings.eyebrow | default: 'Why it works' | escape }}
          </span>
          <h2 class="d2" style="margin-top:12px">
            {{ section.settings.heading | default: 'Tough on grime.<br>Gentle on everything else.' }}
          </h2>
          <p class="body-s" style="max-width:40ch">
            {{ section.settings.text | default: 'Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for.' | escape }}
          </p>
          <a href="{{ section.settings.btn_link | default: '#ingredients' }}" class="btn btn-primary">
            {{ section.settings.btn_label | default: 'See the ingredient list' | escape }}
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24">
              <path d="M5 12h13m-5-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <!-- Right Column: Product Rotator Component -->
        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            <span aria-label="Purelane foaming kitchen cleaner" class="pimg p-kitchen on" data-name="Kitchen cleaner" data-note="Foam lifts grease, no scrubbing" role="img"></span>
            <span aria-label="Purelane tap cleaner and limescale remover" class="pimg p-tap" data-name="Tap &amp; limescale" data-note="Melts hard water stains" role="img"></span>
            <span aria-label="Purelane non-toxic laundry detergent" class="pimg p-laundry" data-name="Laundry detergent" data-note="Tough on odour, soft on fabric" role="img"></span>
            <span aria-label="Purelane non-toxic toilet cleaner" class="pimg p-toilet" data-name="Toilet cleaner" data-note="Kills 99.9% of germs" role="img"></span>
            <span aria-label="Purelane natural herbal floor cleaner" class="pimg p-floor" data-name="Floor cleaner" data-note="Neem powered, pet safe" role="img"></span>
            <span aria-label="Purelane organic dishwash liquid gel" class="pimg p-dish" data-name="Dishwash gel" data-note="Cuts grease, kind to hands" role="img"></span>
          </div>
          <div class="cap">
            <b>Kitchen cleaner</b>
            <span>Foam lifts grease, no scrubbing</span>
          </div>
          <div class="dots">
            <i class="on"></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
        </div>
      </div>

      <!-- Proof Stats Banner -->
      <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
        <div class="stat">
          <div class="ring">{{ section.settings.stat_1_val | default: '99.9%' | escape }}</div>
          <h5>{{ section.settings.stat_1_title | default: 'Germ kill' | escape }}</h5>
          <p>{{ section.settings.stat_1_sub | default: 'Tested against germs and bacteria' | escape }}</p>
        </div>

        <div class="stat">
          <div class="ring">{{ section.settings.stat_2_val | default: '0%' | escape }}</div>
          <h5>{{ section.settings.stat_2_title | default: 'Sulphates' | escape }}</h5>
          <p>{{ section.settings.stat_2_sub | default: 'No SLS, chlorine or parabens' | escape }}</p>
        </div>

        <div class="stat">
          <div class="ring">{{ section.settings.stat_3_val | default: '100%' | escape }}</div>
          <h5>{{ section.settings.stat_3_title | default: 'Plant based' | escape }}</h5>
          <p>{{ section.settings.stat_3_sub | default: 'Cleansers derived from plants' | escape }}</p>
        </div>

        <div class="stat">
          <div class="ring">{{ section.settings.stat_4_val | default: '4.8' | escape }}</div>
          <h5>{{ section.settings.stat_4_title | default: 'Rated' | escape }}</h5>
          <p>{{ section.settings.stat_4_sub | default: 'Across 8,000+ verified reviews' | escape }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

