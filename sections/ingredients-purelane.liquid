{% comment %}
  Purelane Ingredients Section (#ingredients)
  1:1 Visual and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec" data-scene="2" id="ingredients">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">
          {{ section.settings.eyebrow | default: 'Clean without compromise' | escape }}
        </span>
        <h2 class="d2" style="margin-top:12px">
          {{ section.settings.heading | default: 'Sourced from nature' | escape }}
        </h2>
        <p class="lede" style="margin:0 auto">
          {{ section.settings.subtitle | default: 'Plant-derived surfactants and essential oils that cut grime fast, without leaving harsh chemical traces on your counters or plates.' | escape }}
        </p>
      </div>
    </div>

    <div class="grid-4">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign delay_idx = forloop.index0 | modulo: 4
            assign delay_class = ''
            if delay_idx == 1
              assign delay_class = 'rv-d1'
            elsif delay_idx == 2
              assign delay_class = 'rv-d2'
            elsif delay_idx == 3
              assign delay_class = 'rv-d3'
            endif
          -%}
          <div class="glass ing-c rv {{ delay_class }}" {{ block.shopify_attributes }}>
            <div class="ii">
              {%- if block.settings.icon_type == 'dish' -%}
                <span class="pimg p-dish" role="img" aria-label="{{ block.settings.title | escape }}"></span>
              {%- elsif block.settings.icon_type == 'enzyme' -%}
                <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              {%- elsif block.settings.icon_type == 'neem' -%}
                <svg fill="none" stroke="#68d986" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24">
                  <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"></path>
                  <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"></path>
                </svg>
              {%- elsif block.settings.icon_type == 'lemongrass' -%}
                <svg viewBox="0 0 100 100" fill="none">
                  <g stroke="#68d986" stroke-linecap="round" stroke-width="2.2">
                    <path d="M50 88C48 58 46 36 34 6c8 26 12 47 16 76Z"></path>
                    <path d="M52 88C50 60 50 39 44 9c11 29 13 50 12 79Z"></path>
                    <path d="M54 88C56 60 60 40 74 13c-11 28-15 48-16 75Z"></path>
                    <path d="M56 88C60 64 68 48 86 27c-14 22-21 38-26 61Z"></path>
                    <path d="M48 88C44 66 36 50 18 30c14 21 22 36 27 58Z"></path>
                  </g>
                  <path d="M50 88h6" stroke="#f0a03c" stroke-linecap="round" stroke-width="2.4"></path>
                </svg>
              {%- else -%}
                <span class="pimg p-dish" role="img" aria-label="{{ block.settings.title | escape }}"></span>
              {%- endif -%}
            </div>
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.description | escape }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Prototype 4 Ingredient Cards -->
        <div class="glass ing-c rv">
          <div class="ii">
            <span class="pimg p-dish" role="img" aria-label="Coconut Surfactants"></span>
          </div>
          <h4>Coconut surfactants</h4>
          <p>Lifts grease and grime without stripping skin or damaging surfaces</p>
        </div>

        <div class="glass ing-c rv rv-d1">
          <div class="ii">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h4>Bio enzymes</h4>
          <p>Breaks down organic stains and food residues naturally</p>
        </div>

        <div class="glass ing-c rv rv-d2">
          <div class="ii">
            <svg fill="none" stroke="#68d986" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"></path>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"></path>
            </svg>
          </div>
          <h4>Neem extract</h4>
          <p>Time-tested antibacterial protection for floors and counters</p>
        </div>

        <div class="glass ing-c rv rv-d3">
          <div class="ii">
            <svg viewBox="0 0 100 100" fill="none">
              <g stroke="#68d986" stroke-linecap="round" stroke-width="2.2">
                <path d="M50 88C48 58 46 36 34 6c8 26 12 47 16 76Z"></path>
                <path d="M52 88C50 60 50 39 44 9c11 29 13 50 12 79Z"></path>
                <path d="M54 88C56 60 60 40 74 13c-11 28-15 48-16 75Z"></path>
                <path d="M56 88C60 64 68 48 86 27c-14 22-21 38-26 61Z"></path>
                <path d="M48 88C44 66 36 50 18 30c14 21 22 36 27 58Z"></path>
              </g>
              <path d="M50 88h6" stroke="#f0a03c" stroke-linecap="round" stroke-width="2.4"></path>
            </svg>
          </div>
          <h4>Lemongrass</h4>
          <p>Clean fragrance with nothing synthetic or overpowering</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Ingredients",
  "tag": "section",
  "class": "purelane-ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Clean without compromise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Sourced from nature"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Plant-derived surfactants and essential oils that cut grime fast, without leaving harsh chemical traces on your counters or plates."
    }
  ],
  "blocks": [
    {
      "type": "ingredient_card",
      "name": "Ingredient Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            { "value": "dish", "label": "Coconut / Bottle Image" },
            { "value": "enzyme", "label": "Bio Enzyme SVG" },
            { "value": "neem", "label": "Neem Leaf SVG" },
            { "value": "lemongrass", "label": "Lemongrass SVG" }
          ],
          "default": "dish"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient Name",
          "default": "Coconut surfactants"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Lifts grease and grime without stripping skin or damaging surfaces"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ingredients",
      "blocks": [
        {
          "type": "ingredient_card",
          "settings": {
            "icon_type": "dish",
            "title": "Coconut surfactants",
            "description": "Lifts grease and grime without stripping skin or damaging surfaces"
          }
        },
        {
          "type": "ingredient_card",
          "settings": {
            "icon_type": "enzyme",
            "title": "Bio enzymes",
            "description": "Breaks down organic stains and food residues naturally"
          }
        },
        {
          "type": "ingredient_card",
          "settings": {
            "icon_type": "neem",
            "title": "Neem extract",
            "description": "Time-tested antibacterial protection for floors and counters"
          }
        },
        {
          "type": "ingredient_card",
          "settings": {
            "icon_type": "lemongrass",
            "title": "Lemongrass",
            "description": "Clean fragrance with nothing synthetic or overpowering"
          }
        }
      ]
    }
  ]
}
{% endschema %}
