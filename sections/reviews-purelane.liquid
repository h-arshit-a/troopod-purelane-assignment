{% comment %}
  Purelane Reviews Section (#reviews)
  1:1 Visual, marquee, and content match with purelane-homepage.html prototype
{% endcomment %}

<section class="sec revband" data-scene="1" id="reviews">
  <div class="wrap">
    <!-- Header Banner -->
    <div class="revhead rv">
      <span class="kicker">
        {{ section.settings.eyebrow | default: "That's what they said" | escape }}
      </span>

      <span class="agg">
        <span class="st">★★★★★</span>
        <b>{{ section.settings.rating_score | default: '4.8' | escape }}</b>
        {{ section.settings.reviews_count_text | default: 'from 8,000+ reviews' | escape }}
      </span>

      <span class="agg">
        {{ section.settings.homes_text_prefix | default: 'Loved by' | escape }}
        <b>{{ section.settings.homes_count | default: '12 lakh+' | escape }}</b>
        {{ section.settings.homes_text_suffix | default: 'homes' | escape }}
      </span>
    </div>
  </div>

  <!-- Horizontal Marquee Rail -->
  <div class="revrail rv" aria-label="{{ section.settings.aria_label | default: 'Customer reviews' | escape }}">
    <div class="revtrack">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">{{ block.settings.stars | default: '★★★★★' | escape }}</div>
            <h5>{{ block.settings.title | escape }}</h5>
            <p>{{ block.settings.quote | escape }}</p>
            <div class="who">
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24">
                <path d="m5 13 4 4L19 7"></path>
              </svg>
              <b>{{ block.settings.author | escape }}</b>
              <span>{{ block.settings.product_tag | escape }}</span>
            </div>
          </article>
        {%- endfor -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" aria-hidden="true">
            <div class="st">{{ block.settings.stars | default: '★★★★★' | escape }}</div>
            <h5>{{ block.settings.title | escape }}</h5>
            <p>{{ block.settings.quote | escape }}</p>
            <div class="who">
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24">
                <path d="m5 13 4 4L19 7"></path>
              </svg>
              <b>{{ block.settings.author | escape }}</b>
              <span>{{ block.settings.product_tag | escape }}</span>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- Prototype Default 10 Review Cards (5 Unique, Duplicated) -->
        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Works like a charm</h5>
          <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Anita</b>
            <span>· Laundry detergent</span>
          </div>
        </article>

        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Best dishwash ever</h5>
          <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Priya</b>
            <span>· Dishwash gel</span>
          </div>
        </article>

        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Great product, great packaging</h5>
          <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Sunita</b>
            <span>· Liquid handwash</span>
          </div>
        </article>

        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Dog friendly</h5>
          <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Rohit S.</b>
            <span>· Floor cleaner</span>
          </div>
        </article>

        <article class="glass-2 rcard">
          <div class="st">★★★★★</div>
          <h5>Sparkling taps again</h5>
          <p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Verified buyer</b>
            <span>· Tap cleaner</span>
          </div>
        </article>

        <!-- Duplicate Set for Continuous Marquee Loop -->
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">★★★★★</div>
          <h5>Works like a charm</h5>
          <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Anita</b>
            <span>· Laundry detergent</span>
          </div>
        </article>

        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">★★★★★</div>
          <h5>Best dishwash ever</h5>
          <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Priya</b>
            <span>· Dishwash gel</span>
          </div>
        </article>

        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">★★★★★</div>
          <h5>Great product, great packaging</h5>
          <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Sunita</b>
            <span>· Liquid handwash</span>
          </div>
        </article>

        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">★★★★★</div>
          <h5>Dog friendly</h5>
          <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Rohit S.</b>
            <span>· Floor cleaner</span>
          </div>
        </article>

        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">★★★★★</div>
          <h5>Sparkling taps again</h5>
          <p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p>
          <div class="who">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"></path></svg>
            <b>Verified buyer</b>
            <span>· Tap cleaner</span>
          </div>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
